{
  "name": "stkcraft-web",
  "version": "0.1.14",
  "private": true,
  "description": "Official STKCraft launch site — open-source space mission analysis.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-version.mjs && next build",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "visitors": "tsx deploy/show-visitors.ts",
    "visitors:collect": "tsx deploy/visitor-log.ts",
    "geoip:update": "tsx deploy/update-geoip.ts"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "d3-geo": "^3.1.2",
    "ipaddr.js": "^2.5.0",
    "maxmind": "^5.0.8",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.5.3"
}
