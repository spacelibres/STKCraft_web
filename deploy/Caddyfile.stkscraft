# Enable after www.stkcraft.com resolves to this VPS.
# Install as /etc/caddy/conf.d/stkscraft.caddy and reload Caddy.
www.stkcraft.com {
	encode gzip

	log {
		output file /var/log/caddy/stkscraft-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@mutable not path /_next/static/*
	header @mutable Cache-Control "no-cache"

	handle /api/visitors {
		reverse_proxy 127.0.0.1:8788
	}

	handle /health {
		reverse_proxy 127.0.0.1:8788
	}

	handle /webhook {
		reverse_proxy 127.0.0.1:8788
	}

	handle {
		root * /var/www/stkscraft
		try_files {path} {path}/ {path}/index.html /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
